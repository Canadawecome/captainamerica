    } ]
  }, {
    "tStartMs": 4200,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "[theme music playing]"
    } ]
  }, {
    "tStartMs": 5280,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "-[thunk]\n-Oh."
    } ]
  }, {
    "tStartMs": 7280,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "[keys clacking]"
    } ]
  }, {
    "tStartMs": 9480,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "-Yeah!\n-This isn't my fault."
    } ]
  }, {
    "tStartMs": 11120,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "[keys clacking]"
    } ]
  }, {
    "tStartMs": 12720,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "-Oh, my God.\n-Oh, my God."
    } ]
  }, {
    "tStartMs": 16280,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "Aah!"
    } ]
  }, {
    "tStartMs": 17360,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "[phone rings]"
    } ]
  }, {
    "tStartMs": 18480,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "[typewriter dings]"
    } ]
  }, {
    "tStartMs": 20040,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Bloody hell."
    } ]
  }, {
    "tStartMs": 21400,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "-Mum?\n-Ahh."
    } ]
  }, {
    "tStartMs": 24560,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "-We did it!\n-Ah!"
    } ]
  }, {
    "tStartMs": 25960,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "-I say!\n-Ha ha!"
    } ]
  }, {
    "tStartMs": 29440,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "[typewriter clacking]"
    } ]
  }, {
    "tStartMs": 34480,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Hello and welcome.\nWelcome to Taskmaster."
    } ]
  }, {
    "tStartMs": 37920,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "The only show\nthat Sir David Attenborough"
    } ]
  }, {
    "tStartMs": 39760,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "described\nas being better than nature."
    } ]
  }, {
    "tStartMs": 42520,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "He did not."
    } ]
  }, {
    "tStartMs": 44200,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Our five endangered species\nwill continue"
    } ]
  }, {
    "tStartMs": 46320,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "to roam the puzzling plains,\nwhich of the tasks will prove"
    } ]
  }, {
    "tStartMs": 49560,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "to be the hungry leopard\nthat drags them down?\nOnly time will tell."
    } ]
  }, {
    "tStartMs": 53880,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "And let me tell you,\nthis rhino he's ready to charge."
    } ]
  }, {
    "tStartMs": 58480,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Please welcome Chloe Petts,"
    } ]
  }, {
    "tStartMs": 61680,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "Isy Suttie, Matt Lucas,"
    } ]
  }, {
    "tStartMs": 66640,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "Nina Conti and Richard Ayoade."
    } ]
  }, {
    "tStartMs": 73320,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "And next to me a man\nwho told me that his\nfavourite animal is a goose"
    } ]
  }, {
    "tStartMs": 77520,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "because and I quote\n'I like the way they honk\nand I like the way they bonk.'"
    } ]
  }, {
    "tStartMs": 82640,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "It's... Little Alex Horne."
    } ]
  }, {
    "tStartMs": 88400,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "What's not to like? Thank you.\nYeah, I do like a goose."
    } ]
  }, {
    "tStartMs": 93000,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Hello. Right, what is\nthis week's prize task category?"
    } ]
  }, {
    "tStartMs": 98280,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Well, yet again\nwe're appealing\nto the younger demographic"
    } ]
  }, {
    "tStartMs": 101520,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "as we've asked them\nto bring in a sick bit\nof lit kit."
    } ]
  }, {
    "tStartMs": 105520,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "-Ooh.\n-Yeah, I know how"
    } ]
  }, {
    "tStartMs": 107120,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "the young people speak.\nI'm down with the kids, Greg."
    } ]
  }, {
    "tStartMs": 110520,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "For example, I think that today\nyou look schwing."
    } ]
  }, {
    "tStartMs": 115120,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "The sickest bit\nof lit kit wins five points"
    } ]
  }, {
    "tStartMs": 117560,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "and five sick bits of lit kit\nwill go home with the winner\nwhich is pretty non-heinous."
    } ]
  }, {
    "tStartMs": 121720,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "-Over to you my homie.\n-Ooh."
    } ]
  }, {
    "tStartMs": 127640,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Chloe, what's your sick bit\nof lit kit?"
    } ]
  }, {
    "tStartMs": 129840,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So all of the young, cool,\ntrendy kids"
    } ]
  }, {
    "tStartMs": 131880,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "are wearing football\nshirts at the moment."
    } ]
  }, {
    "tStartMs": 134480,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "How do you know?"
    } ]
  }, {
    "tStartMs": 135800,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "By going on the website\ntiktok.com."
    } ]
  }, {
    "tStartMs": 139080,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "-[Alex] Tik... TikTok...\n-Ever heard of it?"
    } ]
  }, {
    "tStartMs": 141120,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Yeah, man. [laughs]"
    } ]
  }, {
    "tStartMs": 143400,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "So, I thought what's the--\nthe lit-est kit around."
    } ]
  }, {
    "tStartMs": 146520,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "It's of course Alex's\nteam Chesham United."
    } ]
  }, {
    "tStartMs": 148920,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Ah, the Generals.\nLet's have a look\nat the kit shall we."
    } ]
  }, {
    "tStartMs": 151360,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "-Yeah.\n-Here's Chloe's\nsick bit of lit kit."
    } ]
  }, {
    "tStartMs": 154000,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Okay. So far, I hate it."
    } ]
  }, {
    "tStartMs": 155840,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "-Yeah, turn it round.\n-[Alex] Whoa."
    } ]
  }, {
    "tStartMs": 158800,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "-[Chloe] You love QR codes.\n-[Greg] I do."
    } ]
  }, {
    "tStartMs": 160840,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "-[Chloe] Got a phone on you,\nyou give it a scan?\n-Oh, I have actually."
    } ]
  }, {
    "tStartMs": 164040,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "Do you need me\nto help you open it, Greg?"
    } ]
  }, {
    "tStartMs": 165760,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "No, granddad's\nfine thank you."
    } ]
  }, {
    "tStartMs": 172120,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "[Alex] Ooh."
    } ]
  }, {
    "tStartMs": 176320,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "'You're a winner,\nenjoy an evening of beer\nand burgers on us.' Good."
    } ]
  }, {
    "tStartMs": 181360,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "-Yeah.\n-Sick. Alright, not bad."
    } ]
  }, {
    "tStartMs": 184120,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "-Not bad at all.\n-I suspect two to three points."
    } ]
  }, {
    "tStartMs": 186680,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "-[Greg] Let's see.\n-[Alex] Okay."
    } ]
  }, {
    "tStartMs": 189640,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "-Nina, hello.\n-I've got this\nincredible Scottish cow."
    } ]
  }, {
    "tStartMs": 196040,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "I was not expecting\nthat sentence."
    } ]
  }, {
    "tStartMs": 200000,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "A very lovely costume cow\nwhich I haven't used yet."
    } ]
  }, {
    "tStartMs": 204000,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "And I love it\nbut I haven't found\nits project yet."
    } ]
  }, {
    "tStartMs": 207000,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Okay well here is,\nhere is Nina's\nsick bit of lit kit."
    } ]
  }, {
    "tStartMs": 212800,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "I am the sickest bit\nof lit kit. Let's take it\nout on the town."
    } ]
  }, {
    "tStartMs": 222400,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "It's a sick bit of lit kit."
    } ]
  }, {
    "tStartMs": 228840,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "I don't know,\nif I went out into the street"
    } ]
  }, {
    "tStartMs": 231200,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and spoke to the kids\nand said what are you into,"
    } ]
  }, {
    "tStartMs": 233600,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "would they say\nmassive talking cows, Nina?"
    } ]
  }, {
    "tStartMs": 237160,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "-I think they would.\n-Alright then."
    } ]
  }, {
    "tStartMs": 238960,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "-It's interesting.\n-It's weird."
    } ]
  }, {
    "tStartMs": 240640,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "It...[laughs]\n-Isy, what did you bring in?"
    } ]
  }, {
    "tStartMs": 242280,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "I have brought in\nNausea by John-Paul Satre."
    } ]
  }, {
    "tStartMs": 249240,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "[Alex] There it is."
    } ]
  }, {
    "tStartMs": 250840,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "This is about some bloke\nwho feels sick all the time."
    } ]
  }, {
    "tStartMs": 254400,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "-It's about existentialism.\n-[Isy] Yeah."
    } ]
  }, {
    "tStartMs": 256200,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "-Existentialism.\n-Erm, and I think\nthat this, this is"
    } ]
  }, {
    "tStartMs": 258640,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "-a literal interpretation.\n-[Alex] So lit kit is\nliterature kit right."
    } ]
  }, {
    "tStartMs": 262360,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "It's a sick bit,\nhe, he feels sick\nof lit kit, it's literature."
    } ]
  }, {
    "tStartMs": 266280,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "How am\nI doing now?"
    } ]
  }, {
    "tStartMs": 268840,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "You're drawing with someone."
    } ]
  }, {
    "tStartMs": 273240,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Erm, okay Matt."
    } ]
  }, {
    "tStartMs": 274520,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "So, I've found a literacy kit."
    } ]
  }, {
    "tStartMs": 276920,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "Erm, and I left it\nout in the rain and it caught\na cold, it got sick."
    } ]
  }, {
    "tStartMs": 281760,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Erm, we, we\ncan see a photo."
    } ]
  }, {
    "tStartMs": 283560,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "This is Matt's\nsick bit of lit kit."
    } ]
  }, {
    "tStartMs": 286440,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Here we go."
    } ]
  }, {
    "tStartMs": 292720,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "It's a poorly bit of literature."
    } ]
  }, {
    "tStartMs": 294320,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "That is a sick bit\nof literacy kit."
    } ]
  }, {
    "tStartMs": 297520,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Oh god. I've never been\nin a situation where I can't,"
    } ]
  }, {
    "tStartMs": 301200,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "I can't work out\nwhose is the worst.\nIt is fascinating."
    } ]
  }, {
    "tStartMs": 306360,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "-But you my friend are\ngonna save this.\n-No."
    } ]
  }, {
    "tStartMs": 311920,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "-Here's the kit.\n-Okay, let's go."
    } ]
  }, {
    "tStartMs": 314160,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "A looper pedal.\nWhat do you children like?\nEd Sheeran."
    } ]
  }, {
    "tStartMs": 319360,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "I think they do\nlike Ed Sheeran don't they?"
    } ]
  }, {
    "tStartMs": 321800,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "He invented the looper pedal."
    } ]
  }, {
    "tStartMs": 323520,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "He did.\nHe brings people together.\n-[Alex] Here it is."
    } ]
  }, {
    "tStartMs": 326000,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "And then I lit it on fire."
    } ]
  }, {
    "tStartMs": 330720,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "And then I was sick next to it."
    } ]
  }, {
    "tStartMs": 334240,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "[laughs]"
    } ]
  }, {
    "tStartMs": 336600,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "It's a sick bit of lit kit."
    } ]
  }, {
    "tStartMs": 338280,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "It's got everything hasn't it.\nIt's something the kids"
    } ]
  }, {
    "tStartMs": 340720,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "would be into\nand it's got some punnery in it."
    } ]
  }, {
    "tStartMs": 343040,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "It's a lovely bit\nof work surely."
    } ]
  }, {
    "tStartMs": 344880,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "You're looking for\nthe least sick bit of lit kit..."
    } ]
  }, {
    "tStartMs": 347360,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "-for one point.\n-[Greg] One point for the cow.\nI don't think"
    } ]
  }, {
    "tStartMs": 350560,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "the kids would be into\nMatt's snotty literature joke."
    } ]
  }, {
    "tStartMs": 353360,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "All I was asked to bring in\nwas a sick bit of lit kit."
    } ]
  }, {
    "tStartMs": 355600,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "-And that's exactly\nwhat I did, young man.\n-You did a joke."
    } ]
  }, {
    "tStartMs": 358280,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "[laughs]"
    } ]
  }, {
    "tStartMs": 359960,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "You did a joke, I'm giving you\ntwo points for it."
    } ]
  }, {
    "tStartMs": 362040,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Isy, I think probably\nthere's some pretentious\nyoung people"
    } ]
  }, {
    "tStartMs": 364360,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "-who are into that novel.\n-Yes."
    } ]
  }, {
    "tStartMs": 366040,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "I'll give it three points.\nI'm gonna give Chloe"
    } ]
  }, {
    "tStartMs": 368240,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "because I think the kids love\nall that, don't they?"
    } ]
  }, {
    "tStartMs": 370480,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Scanning stuff\nto win free things.\nI'm giving that four points."
    } ]
  }, {
    "tStartMs": 373680,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "-But he, he's nailed it.\nThe man's nailed it.\n-That's right."
    } ]
  }, {
    "tStartMs": 376440,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "-It's a sick bit of kit.\n-[Alex and Garry] Five points\nto Richard Ayoade."
    } ]
  }, {
    "tStartMs": 386400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Alright, it's task time."
    } ]
  }, {
    "tStartMs": 388880,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "[Alex] Okay, it certainly is.\n[gasps] Whoopsie."
    } ]
  }, {
    "tStartMs": 392840,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "[thunderclap]"
    } ]
  }, {
    "tStartMs": 410200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "-Hello.\n-[Alex] Hello Nina."
    } ]
  }, {
    "tStartMs": 411880,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "-Down to business.\n-[Alex] Let's do it."
    } ]
  }, {
    "tStartMs": 414000,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "-Let's do it, babe.\n-Right, okay. Here we go."
    } ]
  }, {
    "tStartMs": 419560,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "-I...\n-[Alex] What's wrong?"
    } ]
  }, {
    "tStartMs": 422200,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "-It's got some\nlike Nutella on it.\n-[Alex] Oh whoopsie."
    } ]
  }, {
    "tStartMs": 428320,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "That is so good."
    } ]
  }, {
    "tStartMs": 430040,
    "dDurationMs": 4360,
    "segs": [ {
