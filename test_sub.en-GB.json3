    "segs": [ {
      "utf8": "-You've got three questions.\n-Okay number two,"
    } ]
  }, {
    "tStartMs": 1339360,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "if I give you four eggs\nwill you hold up a pineapple?"
