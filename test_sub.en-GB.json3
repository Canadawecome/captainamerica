      "utf8": "[mysterious theme playing]"
    } ]
  }, {
    "tStartMs": 1770040,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "-Hello.\n-Oh good, you made it.\nAll fine?"
    } ]
  }, {
    "tStartMs": 1772960,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "-All fine.\n-[Alex] Good journey."
    } ]
  }, {
    "tStartMs": 1774680,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "-Yes.\n-You alright?"
    } ]
  }, {
    "tStartMs": 1776640,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "-[Alex] Horrible out there.\n-Yeah, nasty weather."
    } ]
  }, {
    "tStartMs": 1778760,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "-[Alex] Oh.\n-Yeah."
    } ]
  }, {
    "tStartMs": 1780440,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "-[Alex] You made it.\n-Yeah. Long old journey."
    } ]
  }, {
    "tStartMs": 1785040,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "[Alex] Good you came\n'cause you've got a letter."
    } ]
  }, {
    "tStartMs": 1787920,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Ooh."
    } ]
  }, {
    "tStartMs": 1792920,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "-Is this your shoe?\n-Is that your shoe?"
    } ]
  }, {
    "tStartMs": 1795800,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "-That's your shoe.\n-Oh."
    } ]
  }, {
    "tStartMs": 1797760,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "'Get the shoe furthest away\nfrom the other four shoes.'"
    } ]
  }, {
    "tStartMs": 1805720,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Where are the other four shoes?"
    } ]
  }, {
    "tStartMs": 1807400,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "-[Alex] Who else\nis in this show?\n-Oh, the other people?"
    } ]
  }, {
    "tStartMs": 1809840,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "-[Alex] They've got names.\n-Yes."
    } ]
  }, {
    "tStartMs": 1812080,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "-[Alex] And shoes.\n-Read the whole clue?"
    } ]
  }, {
    "tStartMs": 1816720,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "'You have until St Patrick's Day\non which date your shoe"
    } ]
  }, {
    "tStartMs": 1819960,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "must be appropriately\nphotographed\nin its new location.'"
    } ]
  }, {
    "tStartMs": 1822240,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "'With proof that it\nis St Patrick's Day.'"
    } ]
  }, {
    "tStartMs": 1825640,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "-I don't know when that is.\n-[Alex] March."
    } ]
  }, {
    "tStartMs": 1828600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "-March.\n-'There is a bonus point"
    } ]
  }, {
    "tStartMs": 1830440,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "for the shoe that goes\non the most exciting journey.'"
    } ]
  }, {
    "tStartMs": 1833360,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "'Your time starts now.'"
    } ]
  }, {
    "tStartMs": 1835120,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "-[Alex] There's a tracking\ndevice inside the shoe.\n-[laughs]"
    } ]
  }, {
    "tStartMs": 1838760,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "[Alex] Best of luck."
    } ]
  }, {
    "tStartMs": 1843960,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "At that point we'd been doing\nquite a lot of tasks."
    } ]
  }, {
    "tStartMs": 1847080,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "And, erm, what I would like\nto flag is that Isy referred\nto the task as a clue."
    } ]
  }, {
    "tStartMs": 1851320,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "[Alex] Hmm."
    } ]
  }, {
    "tStartMs": 1852760,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Like she was\na member of Scooby Doo. [laughs]"
    } ]
  }, {
    "tStartMs": 1856960,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "[Alex] Thank you, Isy.\nFirst let's see"
    } ]
  }, {
    "tStartMs": 1858920,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "where Chloe's shoe ended up\non St Patrick's Day."
    } ]
  }, {
    "tStartMs": 1862800,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "-I took it on a trip to see\nmany of the sights on Sydney.\n-[Alex] Yes."
    } ]
  }, {
    "tStartMs": 1866640,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "And then I gave it\nto Hannah Gadsby"
    } ]
  }, {
    "tStartMs": 1868240,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "and they performed\nNanette for it."
    } ]
  }, {
    "tStartMs": 1870440,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "[Alex] This is true\nHannah Gadsby did perform"
    } ]
  }, {
    "tStartMs": 1872440,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "their one person\naward-winning show to a shoe."
    } ]
  }, {
    "tStartMs": 1877680,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "And then I took it to meet\nsome Australian celebrities.\nThese kangaroos."
    } ]
  }, {
    "tStartMs": 1883520,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "[Alex] All alive."
    } ]
  }, {
    "tStartMs": 1885280,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "That is absolutely gone at them\nwith the shoe like that. Ah."
    } ]
  }, {
    "tStartMs": 1889880,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Four out of the six\nbludgeoned to death."
    } ]
  }, {
    "tStartMs": 1894200,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "I'm a real Brit abroad, erm.\nFuck you."
    } ]
  }, {
    "tStartMs": 1899520,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "Chloe, where's the proof?\nPart of the task was you had"
    } ]
  }, {
    "tStartMs": 1902760,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to prove that it was\nSt Patrick's Day."
    } ]
  }, {
    "tStartMs": 1905000,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Well, I got a newspaper\nand a pint of Guinness"
    } ]
  }, {
    "tStartMs": 1907360,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "but then I was told that, er,\nthe air tag was the proof"
    } ]
  }, {
    "tStartMs": 1909960,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "so I didn't get a p... photo\nof it with the..."
    } ]
  }, {
    "tStartMs": 1914120,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "[Alex] So we do know\nexactly where it was\non St Patrick's Day."
    } ]
  }, {
    "tStartMs": 1917040,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "Australia."
    } ]
  }, {
    "tStartMs": 1918880,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "-[Alex] Australia very much,\nvery much so in Australia.\n-So you claim."
    } ]
  }, {
    "tStartMs": 1923440,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "-Do you wanna see\nwhere Isy's shoe got to?\n-I do."
    } ]
  }, {
    "tStartMs": 1926480,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "[Alex] Do you wanna explain,\nIsy?"
    } ]
  }, {
    "tStartMs": 1928160,
    "dDurationMs": 6480,
    "segs": [ {
      "utf8": "Okay. Instead of geographically\nI've thrown it into infinity."
    } ]
  }, {
    "tStartMs": 1935160,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Because this is\na petrifying well."
    } ]
  }, {
    "tStartMs": 1938320,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "The water will flow\nover the trainer,\nform a solid coating of rock."
    } ]
  }, {
    "tStartMs": 1943200,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "-[Alex] Mm-hmm.\n-[Isy] And it will be\npreserved forever."
    } ]
  }, {
    "tStartMs": 1946120,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "And full disclosure,\nto me it sounded\nlike horse shit."
    } ]
  }, {
    "tStartMs": 1951320,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "The experts in the well\nsaid it would take three\nto five months."
    } ]
  }, {
    "tStartMs": 1955160,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "-Yes.\n-[Alex] Probably have\na slight crust by March."
    } ]
  }, {
    "tStartMs": 1959680,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Join the club."
    } ]
  }, {
    "tStartMs": 1963080,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "But there is some\nproof there isn't it."
    } ]
  }, {
    "tStartMs": 1965200,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "[Alex] It's proof\nthat it's in Knaresborough\non St Patrick's Day."
    } ]
  }, {
    "tStartMs": 1968200,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "-Do you think your shoe\nwent to the future?\n-Yeah."
    } ]
  }, {
    "tStartMs": 1970680,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "[Alex] Okay."
    } ]
  }, {
    "tStartMs": 1976080,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "-You wanna see one more?\n-Yeah."
    } ]
  }, {
    "tStartMs": 1977960,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Okay. Now it's time\nfor Nina's attempt"
    } ]
  }, {
    "tStartMs": 1980160,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and Nina made\na nice little video\nfor her shoe's journey."
    } ]
  }, {
    "tStartMs": 1983320,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "-Have a look at this.\n-I started in Leeds\nand thought that was exciting."
    } ]
  }, {
    "tStartMs": 1987560,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "But then I flew to Tokyo,\nback to London, then flew\nto Singapore for a swim,"
    } ]
  }, {
    "tStartMs": 1991640,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "then flew to Christchurch\nand went to the many wineries\nof New Zealand."
    } ]
  }, {
    "tStartMs": 1995600,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Back to London.\nAnd I flew to Chile, Patagonia\nand the Torres del Paine"
    } ]
  }, {
    "tStartMs": 1999920,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "then the red rocks of Salta\nthen the 30 hour bus\nto Iguzu Falls and then to Rio,"
    } ]
  }, {
    "tStartMs": 2005040,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Copacabana beach,\nChrist the Redeemer,\nfinishing up on the 17th March"
    } ]
  }, {
    "tStartMs": 2009480,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "on Sugarloaf Mountain\nwith Nina's godson Jasper\nkindly holding me"
    } ]
  }, {
    "tStartMs": 2013880,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "with a newspaper\nto prove that's where I was."
    } ]
  }, {
    "tStartMs": 2022280,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Are you on some\nsort of gap year?"
    } ]
  }, {
    "tStartMs": 2025600,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Yes. That's exactly it.\nMy godson, er,"
    } ]
  }, {
    "tStartMs": 2028000,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "it entered the backpack\nof a gap year student."
    } ]
  }, {
    "tStartMs": 2030960,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Oh, what you\ndidn't go to all those..."
    } ]
  }, {
    "tStartMs": 2032800,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "Latterly.\nI did at the beginning.\nI went to Leeds and...[laughs]"
    } ]
  }, {
    "tStartMs": 2039280,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "But did it go\nto infinity, Greg?"
    } ]
  }, {
    "tStartMs": 2042000,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "I want to keep my cow."
    } ]
  }, {
    "tStartMs": 2046280,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Yeah, it's not\nlooking good, Nina."
    } ]
  }, {
    "tStartMs": 2049880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Now here's Richard's effort."
    } ]
  }, {
    "tStartMs": 2052600,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "In a way, if they all scatter\n'cause they want to get it\nas far away as possible,"
    } ]
  }, {
    "tStartMs": 2059000,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "it being here...\nmight be the wisest thing."
    } ]
  }, {
    "tStartMs": 2064880,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "[Alex] You want me\non the 17th March,"
    } ]
  }, {
    "tStartMs": 2067000,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "-take a picture\nof that shoe here.\n-Yeah."
    } ]
  }, {
    "tStartMs": 2068960,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "-[Alex] And what proof?\n-A copy of the paper\nor you know take the newspaper."
    } ]
  }, {
    "tStartMs": 2074080,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "And I imagine\nyou'll be appropriately dressed."
    } ]
  }, {
    "tStartMs": 2075880,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "-[Alex] What do\nyou mean by that?\n-I mean, er, full emerald."
    } ]
  }, {
    "tStartMs": 2078960,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "[Alex] What you might be\nsacrificing is the bonus point\nfor the exciting journey."
    } ]
  }, {
    "tStartMs": 2082840,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "-But you might be... hmm.\n-Alright."
    } ]
  }, {
    "tStartMs": 2085080,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "[epic music playing]"
    } ]
  }, {
    "tStartMs": 2118440,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "-Talk me through it.\n-Do you have the picture?"
    } ]
  }, {
    "tStartMs": 2121000,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "This is St Patrick's Day\nthis year. Yeah."
    } ]
  }, {
    "tStartMs": 2124280,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Well, I'm thrilled\nwith that image."
    } ]
  }, {
    "tStartMs": 2127400,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "And the journey\nthat the shoe has been on just\nto be absolutely crystal clear."
    } ]
  }, {
    "tStartMs": 2131000,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "That shoe's been\nto hell and back."
    } ]
  }, {
    "tStartMs": 2137120,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "If all four shoes\nwent to Australia...\n-Yes."
    } ]
  }, {
    "tStartMs": 2139720,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "...you'd be right.\nOne went to Knaresborough\nunfortunately."
    } ]
  }, {
    "tStartMs": 2143280,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "But that one isn't even\nin our time continuum. Okay."
    } ]
  }, {
    "tStartMs": 2152680,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "-Show us Matt's shoe.\n-Finally, let's see"
    } ]
  }, {
    "tStartMs": 2155040,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "if Matt's moccasin\ntraversed the globe."
    } ]
  }, {
    "tStartMs": 2158160,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "[charming music playing]"
    } ]
  }, {
    "tStartMs": 2183320,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "[Greg] Wow."
    } ]
  }, {
    "tStartMs": 2186360,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "And originally I wanted\nto send the shoe up into space."
    } ]
  }, {
    "tStartMs": 2190560,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Erm, I have a friend\nwho used to work for NASA."
    } ]
  }, {
    "tStartMs": 2193160,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Erm, but unfortunately\nthere were no space missions,"
    } ]
  }, {
    "tStartMs": 2196200,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "-er, going at that time.\nSo instead...\n-Oldest excuse in the book."
    } ]
  }, {
    "tStartMs": 2200400,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "I know.\nInstead it went to the Yukon."
    } ]
  }, {
    "tStartMs": 2203480,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "To show proof\none more time, this is the proof"
    } ]
  }, {
    "tStartMs": 2205640,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "that Matt's shoe was\nthere on the 17th of March."
    } ]
  }, {
    "tStartMs": 2208280,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "-There we go. Okay.\n-[Greg] Ah."
    } ]
  }, {
    "tStartMs": 2210040,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "[Alex] So we've\nseen all five shoes."
    } ]
  }, {
    "tStartMs": 2212520,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "Now we need some stats\nand I need to make\na decision on a thorny issue."
    } ]
  }, {
    "tStartMs": 2216920,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "[Alex] Chloe's shoe was\n60,683 total miles from here."
    } ]
  }, {
    "tStartMs": 2221800,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "Nina's 44,244, definitely had\nthe most elongated journey."
    } ]
  }, {
    "tStartMs": 2227680,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "Matt's 37,934.\nIncredibly Richard's was further"
    } ]
  }, {
    "tStartMs": 2234040,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "from the others than Isy's\nby 133 miles."
    } ]
  }, {
    "tStartMs": 2238320,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Currently Isy one point,\nRichard two, three for Matt,\nfour for Nina, five to Chloe."
    } ]
  }, {
    "tStartMs": 2242280,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "I'll dock you a point for,\nfor not giving us\neverything we wanted."
    } ]
  }, {
    "tStartMs": 2245240,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "[Alex] So, who gets\nthe bonus point\nfor the most exciting journey?"
    } ]
  }, {
    "tStartMs": 2248120,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Well, it was between Nina\nand Isy for me."
    } ]
  }, {
    "tStartMs": 2250200,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "I sort of like the idea\nthat the shoe is immortalised\nand will live on."
    } ]
  }, {
    "tStartMs": 2255960,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "So for romantic reasons\nI am gonna give Isy\nthe one bonus point."
    } ]
  }, {
    "tStartMs": 2259560,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "-[Alex] One bonus point\nto Isy Suttie.\n-Yes!"
    } ]
  }, {
    "tStartMs": 2265080,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Can Alex make the scoreboard\ngo big screen?"
    } ]
  }, {
    "tStartMs": 2267880,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "He certainly can.\nAnd thanks to that devastating\npoint being docked,"
    } ]
  }, {
    "tStartMs": 2271640,
