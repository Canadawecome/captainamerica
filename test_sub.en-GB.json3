  }, {
    "tStartMs": 1532240,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "number two\ndo you really like eggs?"
    } ]
  }, {
    "tStartMs": 1534480,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Number three,\ndo you really like eggs?\nAh but I took the egg"
