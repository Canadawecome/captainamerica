  }, {
    "tStartMs": 1346480,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "No. [laughs] That would've been\ngood wouldn't it."
    } ]
  }, {
    "tStartMs": 1349720,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "[Alex] Two questions\nleft though, it's worth\nfinding out these things."
    } ]
  }, {
    "tStartMs": 1352600,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "-[gasps] Maybe\nthat's the one who lies.\n-[Alex] Maybe."
    } ]
  }, {
    "tStartMs": 1355040,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Okay, I'm gonna risk it."
    } ]
  }, {
    "tStartMs": 1360280,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "-[Alex] Right you've given\nnumber two four eggs.\n-Yeah."
    } ]
  }, {
    "tStartMs": 1363840,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "[Alex] We're spinning\nand that's the last spin.\nEgg, duck, pineapple."
    } ]
  }, {
    "tStartMs": 1368200,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "So that's another 200 points\nand that's your task over."
    } ]
  }, {
    "tStartMs": 1370640,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Did your system\nof giving him four eggs work?"
    } ]
  }, {
    "tStartMs": 1373360,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Well, it didn't not work.\nHe didn't hold up a pineapple"
    } ]
  }, {
    "tStartMs": 1376400,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "but he did give me\na hundred points."
    } ]
  }, {
    "tStartMs": 1378200,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "[Alex] Okay well we're\nall, it's, it's finished."
    } ]
  }, {
    "tStartMs": 1380320,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "So he wasn't the one who lied\nbut he is the one who's kind."
    } ]
  }, {
    "tStartMs": 1386640,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "-Okay.\n-[Alex] So you're now\non minus 300."
    } ]
  }, {
    "tStartMs": 1388920,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "-I'll just do it again.\n-[Alex] We're spinning."
